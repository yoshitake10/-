# ─── Anthropic Claude API ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-opus-4-7

# ─── Google OAuth2 ─────────────────────────────────────────────────────────────
# Google Cloud Console で作成した OAuth2 クライアント認証情報のJSONファイルパス
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json

# CEO のメインカレンダーID（Googleカレンダーの設定 > カレンダーID で確認）
CEO_CALENDAR_ID=primary

# 中期計画・戦略ドキュメントのGoogle DocsドキュメントID
# URL: https://docs.google.com/document/d/[ここがID]/edit
STRATEGY_DOC_ID=1aBcDeFgHiJkLmNoPqRsTuVwXyZ1234567890

# KPIドキュメントのGoogle DocsドキュメントID
KPI_DOC_ID=1aBcDeFgHiJkLmNoPqRsTuVwXyZ0987654321

# ─── LINE WORKS Bot API v2 ──────────────────────────────────────────────────────
# LINE WORKS Developer Console で Bot を作成して取得
LINEWORKS_BOT_ID=xxxxxx
LINEWORKS_BOT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxx
LINEWORKS_SERVICE_ACCOUNT=xxxxxxxx.serviceaccount@xxxxx
LINEWORKS_PRIVATE_KEY_PATH=lineworks_private.key
LINEWORKS_DOMAIN_ID=xxxxxxxxx

# CEO の LINE WORKS ユーザーID（管理コンソール > メンバー で確認）
LINEWORKS_CEO_USER_ID=xxxxxxxxx

# CEO 専用チャンネルID（オプション）
LINEWORKS_CEO_CHANNEL_ID=

# ─── サクミル API ──────────────────────────────────────────────────────────────
SAKUMIRU_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SAKUMIRU_BASE_URL=https://api.sakumiru.jp/v1
SAKUMIRU_COMPANY_ID=xxxxxxxx

# ─── システム設定 ────────────────────────────────────────────────────────────
TZ=Asia/Tokyo
# シグナル分析の対象期間（日数）
ANALYSIS_WINDOW_DAYS=7
